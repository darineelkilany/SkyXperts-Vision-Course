iU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0=" crossorigin="anonymous"></script><script src="https://cdn.prod.website-files.com/680a070c3b99253410dd3dcf/js/webflow.schunk.57d5559d2f0cd9f8.js" type="text/javascript"></script><script src="https://cdn.prod.website-files.com/680a070c3b99253410dd3dcf/js/webflow.schunk.73734c40d23de330.js" type="text/javascript"></script><script src="https://cdn.prod.website-files.com/680a070c3b99253410dd3dcf/js/webflow.a1ce7872.e4d302a9d3029047.js" type="text/javascript"></script><script>
  // Get the UTM source from the URL
  function getUTMSourceFromURL() {
    const urlParams = new URLSearchParams(window.location.search);
    return urlParams.get("utm_source") || "";
  }

  // Save the UTM source in session storage only if it's not already set
  function saveUTMSourceToSession() {
    const existingUTMSource = sessionStorage.getItem("utm_source");

    // Check if utm_source is already set in sessionStorage
    if (!existingUTMSource) {
      const utmSource = getUTMSourceFromURL();
      sessionStorage.setItem("utm_source", utmSource);
    }
  }

  // Call the function to save the UTM source to session storage
  saveUTMSourceToSession();

  // Copyright Year Auto-Update
  $(document).ready(function () {
    const currentYear = new Date().getFullYear();
    $('[data="year"]').html(currentYear);
  });
</script>

<script>
  // Throttle function to improve scroll performance
  function throttle(fn, delay) {
    let lastCall = 0;
    return function (...args) {
      const now = new Date().getTime();
      if (now - lastCall > delay) {
        lastCall = now;
        fn(...args);
      }
    };
  }

  var navbar = document.querySelector(".u-navbar");
  var scrolledClass = "u-navbar-scrolled";

  // Scrolled Navbar
  if (window.pageYOffset > 50) {
    navbar.classList.add(scrolledClass);
  } else {
    navbar.classList.remove(scrolledClass);
  }

  // Use throttled scroll listener for better performance
  window.addEventListener(
    "scroll",
    throttle(function () {
      if (window.pageYOffset > 50) {
        navbar.classList.add(scrolledClass);
      } else {
        navbar.classList.remove(scrolledClass);
      }
    }, 100),
  );

  // Mobile Navbar Opened
  var navbarTrigger = document.querySelector(".u-nav-trigger");

  const observer = new MutationObserver(function (mutationsList) {
    for (let mutation of mutationsList) {
      if (
        mutation.type === "attributes" &&
        mutation.attributeName === "class"
      ) {
        if (navbarTrigger.classList.contains("w--open")) {
          navbar.style.backgroundColor = "white";
        } else {
          navbar.style.removeProperty("background-color");
        }
      }
    }
  });
  observer.observe(navbarTrigger, { attributes: true });

  // Form Status
  $('[wr-type="error"]').hide(); // Hide errors
  $('[wr-type="required-field"]').removeClass("error"); // Remove error state from fields

  var formErrors = false;

  const fieldError = function (field) {
    field.siblings('[wr-type="error"]').show(); // Show error message
    field.addClass("error"); // Add error state to this field
    formErrors = true;
  };

  // Click on the Submit button - optimized
  $('[wr-type="submit"]').on("click", function () {
    formErrors = false; // Reset errors state at the beginning
    // Check each required field
    $('[wr-type="required-field"]').each(function () {
      if ($(this).val().length === 0) {
        // If this field is empty
        fieldError($(this));
      } else if (
        $(this).attr("type") === "email" && // Validation for email fields
        ($(this).val().indexOf("@") === -1 || $(this).val().indexOf(".") === -1)
      ) {
        fieldError($(this));
      }
    });
    // Submit parent form if there are no errors
    if (!formErrors) $(this).closest("form").submit(); // Use closest instead of parents for better performance
  });

  // Remove errors from field - using event delegation for better performance
  $(document).on("keypress blur", '[wr-type="required-field"]', function () {
    $(this).removeClass("error");
    $(this).siblings('[wr-type="error"]').hide();
    formErrors = false;
  });

  // Press Enter - optimized with event delegation
  $(document).on("keypress", "input, textarea", function (e) {
    if (e.keyCode == 13) {
      e.preventDefault();
      $(this).trigger("change");
      $('[wr-type="submit"]').click();
    }
  });

  // Refresh Form - optimized
  $(document).on("click", '[wr-type="success"]', function () {
    $(this).closest(".w-form").find("form")[0].reset();
  });

  // Top Banner
  const closeButton = document.querySelector(".u-banner-close");
  if (closeButton) {
    closeButton.addEventListener("click", function () {
      sessionStorage.setItem("bannerClosed", "true");
    });
  }

  const isBannerClosed = sessionStorage.getItem("bannerClosed");
  const banner = document.querySelector(".u-banner");
  const bannerOpen = document.querySelector(".u-banner-open");

  if (isBannerClosed === "true") {
    banner.style.display = "none";
    bannerOpen.style.display = "none";
  }

  // All arrow elements
  const sliderButtons = document.querySelectorAll(".u-slider-button-icon");

  // Update parents class
  function updateSliderArrowParentClass(targetElement) {
    const parent = targetElement.parentElement;
    const hasDisabledClass = targetElement.classList.contains(
      "swiper-button-disabled",
    );

    if (hasDisabledClass) {
      parent.classList.add("u-slider-button-disabled");
    } else {
      parent.classList.remove("u-slider-button-disabled");
    }
  }

  function handleClassChange(mutationsList) {
    mutationsList.forEach((mutation) => {
      if (mutation.type === "attributes") {
        if (mutation.attributeName === "class") {
          updateSliderArrowParentClass(mutation.target);
        }
      }
    });
  }

  const observerSliderButtons = new MutationObserver(handleClassChange);

  if (sliderButtons.length > 0) {
    sliderButtons.forEach((button) => {
      // Check on load
      updateSliderArrowParentClass(button);
      // Create MutationObserver
      observerSliderButtons.observe(button, { attributes: true });
    });
  }
</script>

<script>
  function convertFormToJSON(form) {
    var array = $(form).serializeArray();
    var json = {};
    $.each(array, function () {
      json[this.name] = this.value || "";
    });
    return json;
  }

  // Newsletter form handling - improved with event delegation
  $(document).ready(function () {
    $(document).on(
      "submit",
      'form[action="https://website-forms-885297101091.europe-west1.run.app/newsletter"]',
      function (e) {
        e.preventDefault();

        var form = $(this);
        var btn = $("#submit-newsletter");
        btn.val("Wait...");
        btn.addClass("loading");
        btn.attr("disabled", true);

        var parent = form.parent();
        parent.find(".u-form-footer-error").css("display", "none");

        var data = convertFormToJSON(form);
        data["entryPoint"] = "newsletter";
        var action = form.attr("action");

        $.ajax({
          url: action,
          method: "POST",
          data: JSON.stringify(data),
          contentType: "application/json",
          dataType: "json",
          success: function () {
            // Hide the form
            parent.children("form").css("display", "none");
            // Display the "Done" block
            parent.find(".u-form-footer-success").css("display", "block");
            btn.val("Sign up");
            btn.removeClass("loading");
            btn.attr("disabled", false);
            // Clear input (we could skip this)
            var email = $("#newsletter-email");
            email.val("");
          },
          error: function () {
            // Display the "Failed" block
            parent.find(".u-form-footer-error").css("display", "block");
            btn.val("Sign up");
            btn.removeClass("loading");
            btn.attr("disabled", false);
          },
        });
      },
    );
  });
</script>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    // Create script element
    const script = document.createElement("script");
    script.id = "inkeep-script";
    script.src =
      "https://cdn.jsdelivr.net/npm/@inkeep/cxkit-js@0.5/dist/embed.js";
    script.type = "module";
    script.defer = true;

    // Initialize widget after script loads
    script.addEventListener("load", function () {
      Inkeep.ChatButton({
        baseSettings: {
          apiKey: "656b7df47678097fa23d8f22ed2cb8c5153899ed6ab2f353",
          primaryBrandColor: "#E1FF25",
          organizationDisplayName: "Ultralytics",
          theme: {
            // Custom styles injection
            styles: [
              {
                key: "chat-button",
                type: "style",
                value: `
              /* Light mode styling */
              .ikp-chat-button__button {
                background-color: #E1FF25;
                color: #111F68;
              }
              /* Dark mode styling */
              [data-theme="dark"] .ikp-chat-button__button {
                background-color: #40434f;
                color: #ffffff;
              }
              .ikp-chat-button__container {
                position: fixed;
                right: 1rem;
                bottom: 3rem;
              }
            `,
              },
              {
              key: 'custom-z-index',
              type: 'style',
              value: `
                .ikp-modal { z-index: 10000 !important; }
                .ikp-modal__overlay { z-index: 10000 !important; }
                .ikp-modal__content { z-index: 10000 !important; }
                .ikp-popover { z-index: 10100 !important; }
                .ikp-toast { z-index: 10300 !important; }
                .ikp-tooltip { z-index: 10400 !important; }
              `
              }
            ],
          },
        },
        modalSettings: {},
        searchSettings: {},
        aiChatSettings: {
          aiAssistantAvatar:
            "https://storage.googleapis.com/organization-image-assets/ultralytics-botAvatarSrcUrl-1729379860806.svg",
          exampleQuestions: [
            "What's new in YOLO11?",
            "How can I get started with Ultralytics HUB?",
            "How does Ultralytics Enterprise Licensing work?",
          ],
          getHelpCallToActions: [
            {
              name: "Ask on Ultralytics GitHub",
              url: "https://github.com/ultralytics/ultralytics",
              icon: { builtIn: "FaGithub" },
            },
            {
              name: "Ask on Ultralytics Discourse",
              url: "https://community.ultralytics.com/",
              icon: { builtIn: "FaDiscourse" },
            },
            {
              name: "Ask on Ultralytics Discord",
              url: "https://discord.com/invite/ultralytics",
              icon: { builtIn: "FaDiscord" },
            },
          ],
        },
      });
    });

    // Add script to document
    document.body.appendChild(script);
  });
</script>


<script>
// GitHub Stars Fetcher for Ultralytics Organization
class UltralyticsGitHubStars {
  constructor() {
    this.orgName = 'ultralytics';
    this.apiUrl = `https://api.allorigins.win/get?url=${encodeURIComponent(`https://api.github.com/orgs/${this.orgName}/repos?per_page=100&sort=stars&order=desc`)}`;
    this.cacheKey = 'ultralytics-org-stars';
    this.cacheExpiry = 6 * 60 * 60 * 1000; // 6 hours (21,600,000 ms)
    this.initialStars = 112316; // Current known star count
    this.init();
  }

  init() {
    // Show initial count immediately
    this.showInitialCount();
    
    // Then fetch real data in background
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => this.fetchAllStarsBackground());
    } else {
      this.fetchAllStarsBackground();
    }
  }

  showInitialCount() {
    // First check cache for instant display
    const cached = this.getFromCache();
    if (cached) {
      console.log('⚡ Instant display from cache:', this.formatStarCount(cached.total));
      this.updateButtons(cached.total);
      return;
    }

    // If no cache, show current known count immediately
    console.log('⚡ Instant display with current count:', this.formatStarCount(this.initialStars));
    this.updateButtons(this.initialStars);
  }

  async fetchAllStarsBackground() {
    try {
      // Check if we have recent cached data
      const cached = this.getFromCache();
      if (cached) {
        console.log('✅ Using cached data, no background fetch needed');
        // Still update buttons to ensure they're set
        this.updateButtons(cached.total);
        return;
      }

      console.log('🔄 Background fetch: Getting fresh data from GitHub...');
      
      const allRepos = await this.fetchAllRepos();
      const totalStars = this.calculateTotalStars(allRepos);
      
      console.log(`⭐ Background fetch complete: ${totalStars.toLocaleString()} total stars`);
      
      // Log top repositories for reference
      const topRepos = allRepos
        .sort((a, b) => b.stargazers_count - a.stargazers_count)
        .slice(0, 10);
      
      console.log('🏆 Top 10 repositories by stars:');
      topRepos.forEach((repo, index) => {
        console.log(`${index + 1}. ${repo.name}: ${repo.stargazers_count.toLocaleString()} stars`);
      });

      const cacheData = {
        total: totalStars,
        breakdown: topRepos.map(repo => ({
          name: repo.name,
          stars: repo.stargazers_count,
          url: repo.html_url
        })),
        repoCount: allRepos.length
      };

      this.saveToCache(cacheData);
      
      // Update buttons with real data (smooth transition)
      this.updateButtonsSmooth(totalStars);

    } catch (error) {
      console.error('❌ Background fetch failed:', error);
      
      // Try alternative CORS proxy
      try {
        await this.fetchWithAlternativeProxy();
      } catch (altError) {
        console.error('❌ Alternative fetch also failed:', altError);
        console.log('🔄 Keeping current displayed value');
        // Don't update buttons if both methods fail - keep current value
      }
    }
  }

  async fetchAllRepos() {
    let allRepos = [];
    let page = 1;
    let hasMore = true;

    while (hasMore) {
      const pageUrl = `https://api.allorigins.win/get?url=${encodeURIComponent(`https://api.github.com/orgs/${this.orgName}/repos?per_page=100&page=${page}&sort=stars&order=desc`)}`;
      
      const response = await fetch(pageUrl, {
        method: 'GET',
        headers: {
          'Accept': 'application/json',
        }
      });

      if (!response.ok) {
        throw new Error(`HTTP error! status: ${response.status} for page ${page}`);
      }

      const data = await response.json();
      const repos = JSON.parse(data.contents);
      
      console.log(`📦 Fetched page ${page}: ${repos.length} repositories`);
      
      if (repos.length === 0) {
        hasMore = false;
      } else {
        allRepos = allRepos.concat(repos);
        page++;
        
        // GitHub API typically returns 100 repos per page max
        // If we get less than 100, we've reached the end
        if (repos.length < 100) {
          hasMore = false;
        }
      }
    }

    return allRepos;
  }

  async fetchWithAlternativeProxy() {
    console.log('🔄 Trying alternative CORS proxy...');
    
    const altUrl = `https://corsproxy.io/?${encodeURIComponent(`https://api.github.com/orgs/${this.orgName}/repos?per_page=100&sort=stars&order=desc`)}`;
    
    const response = await fetch(altUrl);
    if (!response.ok) {
      throw new Error(`Alternative proxy failed! status: ${response.status}`);
    }

    const repos = await response.json();
    const totalStars = this.calculateTotalStars(repos);

    console.log('✅ Alternative fetch successful. Total stars:', totalStars);
    
    const cacheData = {
      total: totalStars,
      breakdown: repos.slice(0, 10).map(repo => ({
        name: repo.name,
        stars: repo.stargazers_count,
        url: repo.html_url
      })),
      repoCount: repos.length
    };

    this.saveToCache(cacheData);
    this.updateButtonsSmooth(totalStars);
  }

  calculateTotalStars(repos) {
    return repos.reduce((total, repo) => total + repo.stargazers_count, 0);
  }

  formatStarCount(count) {
    // Always return comma-separated format (e.g., "110,300" instead of "110.3K")
    return count.toLocaleString();
  }

  updateButtons(starCount) {
    const formattedCount = this.formatStarCount(starCount);
    
    // Find all buttons with data-github-stars attribute
    const buttons = document.querySelectorAll('[data-github-stars]');
    
    if (buttons.length === 0) {
      console.warn('⚠️ No buttons found with [data-github-stars] attribute');
      return;
    }

    let updateCount = 0;
    
    buttons.forEach((button, index) => {
      // Look for star count element inside this button
      const countElement = button.querySelector('[data-star-count]');
      
      if (countElement) {
        countElement.textContent = formattedCount;
        updateCount++;
        console.log(`✅ Updated button ${index + 1} with: ${formattedCount}`);
      } else {
        console.warn(`⚠️ Button ${index + 1} missing [data-star-count] element`);
      }
    });

    console.log(`🎉 Successfully updated ${updateCount}/${buttons.length} buttons`);
  }

  updateButtonsSmooth(starCount) {
    const formattedCount = this.formatStarCount(starCount);
    
    // Find all buttons with data-github-stars attribute
    const buttons = document.querySelectorAll('[data-github-stars]');
    
    buttons.forEach((button, index) => {
      const countElement = button.querySelector('[data-star-count]');
      
      if (countElement) {
        // Add a subtle fade effect if the number changed
        const currentText = countElement.textContent;
        if (currentText !== formattedCount) {
          countElement.style.transition = 'opacity 0.3s ease';
          countElement.style.opacity = '0.7';
          
          setTimeout(() => {
            countElement.textContent = formattedCount;
            countElement.style.opacity = '1';
            console.log(`🔄 Smoothly updated button ${index + 1} to: ${formattedCount}`);
          }, 150);
        }
      }
    });
  }

  getFromCache() {
    try {
      const cached = localStorage.getItem(this.cacheKey);
      if (cached) {
        const { value, timestamp } = JSON.parse(cached);
        if (Date.now() - timestamp < this.cacheExpiry) {
          return value;
        } else {
          console.log('🕐 Cache expired, fetching fresh data');
        }
      }
    } catch (error) {
      console.error('❌ Error reading from cache:', error);
    }
    return null;
  }

  saveToCache(value) {
    try {
      const cacheData = {
        value,
        timestamp: Date.now()
      };
      localStorage.setItem(this.cacheKey, JSON.stringify(cacheData));
      console.log('💾 Saved to cache - Total stars:', value.total.toLocaleString(), 'Repos:', value.repoCount);
    } catch (error) {
      console.error('❌ Error saving to cache:', error);
    }
  }

  // Manual refresh method for testing
  refresh() {
    localStorage.removeItem(this.cacheKey);
    console.log('🗑️ Cache cleared, fetching fresh data...');
    this.fetchAllStarsBackground();
  }

  // Debug method to check setup
  checkSetup() {
    const buttons = document.querySelectorAll('[data-github-stars]');
    console.log(`🔍 Found ${buttons.length} button(s) with [data-github-stars]`);
    
    buttons.forEach((button, index) => {
      const countElement = button.querySelector('[data-star-count]');
      console.log(`Button ${index + 1}:`, {
        hasButton: true,
        hasCountElement: !!countElement,
        currentText: countElement ? countElement.textContent : 'N/A'
      });
    });
  }

  // Method to show detailed breakdown
  showBreakdown() {
    const cached = this.getFromCache();
    if (cached) {
      console.log('📊 Ultralytics Organization Star Breakdown:');
      console.log(`Total: ${cached.total.toLocaleString()} stars across ${cached.repoCount} repositories`);
      console.log('Top repositories:');
      cached.breakdown.forEach((repo, index) => {
        console.log(`${index + 1}. ${repo.name}: ${repo.stars.toLocaleString()} stars`);
      });
    } else {
      console.log('No cached data available. Run refreshGitHubStars() first.');
    }
  }

  // Method to update the initial star count (for future updates)
  updateInitialCount(newCount) {
    this.initialStars = newCount;
    localStorage.removeItem(this.cacheKey); // Clear cache to force fresh fetch
    console.log(`📈 Updated initial star count to: ${newCount.toLocaleString()}`);
  }
}

// Initialize when page loads
window.ultralyticsStars = new UltralyticsGitHubStars();

// Debug functions for testing in console
window.refreshGitHubStars = () => window.ultralyticsStars.refresh();
window.checkGitHubSetup = () => window.ultralyticsStars.checkSetup();
window.showStarBreakdown = () => window.ultralyticsStars.showBreakdown();
window.updateInitialStars = (count) => window.ultralyticsStars.updateInitialCount(count);
</script><script src="https://hubspotonwebflow.com/assets/js/form-124.js" type="text/javascript" integrity="sha384-bjyNIOqAKScdeQ3THsDZLGagNN56B4X2Auu9YZIGu+tA/PlggMk4jbWruG/P6zYj" crossorigin="anonymous"></script><script src="https://cdn.prod.website-files.com/680a070c3b99253410dd3dcf%2F6470f5217e03b0faa8a404de%2F680a070c3b99253410dd3dfc%2Fhs_trackcode_44351537-1.0.6.js" type="text/javascript"></script></body></html>