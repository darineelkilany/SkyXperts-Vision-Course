<!-- Deferred loading of highlight.js CSS and JS with initialization -->
<script>
  document.addEventListener("DOMContentLoaded", function () {
    // Only load highlight.js resources if code blocks exist
    if (document.querySelector("pre code")) {
      // Preload CSS for better performance
      const preloadLink = document.createElement("link");
      preloadLink.rel = "preload";
      preloadLink.as = "style";
      preloadLink.href =
        "https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/github.min.css";
      document.head.appendChild(preloadLink);

      // Load CSS
      const cssLink = document.createElement("link");
      cssLink.rel = "stylesheet";
      cssLink.href = preloadLink.href;
      document.head.appendChild(cssLink);

      // Load JS with callback to initialize
      const script = document.createElement("script");
      script.src =
        "https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js";
      script.onload = function () {
        // Initialize highlight.js when script loads
        hljs.highlightAll();
      };
      document.body.appendChild(script);
    }
  });
</script>

